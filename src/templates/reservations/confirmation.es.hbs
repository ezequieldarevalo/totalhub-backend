<div
  style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; border: 1px solid #ddd; padding: 20px; border-radius: 8px;">
  <img src="https://booking.totalhostel.com.ar/images/logo-hostel.jpg" alt="Total Hostel"
    style="max-width: 200px; display: block; margin: 0 auto 16px;" />

  <h2 style="color: #333;">¡Hola {{name}}!</h2>
  <p style="font-size: 16px;">Tu reserva fue confirmada:</p>

  <table style="width: 100%; font-size: 16px; margin-top: 16px;">
    <tr>
      <td><strong>Habitación:</strong></td>
      <td>{{room}}</td>
    </tr>
    <tr>
      <td><strong>Desde:</strong></td>
      <td>{{from}}</td>
    </tr>
    <tr>
      <td><strong>Hasta:</strong></td>
      <td>{{to}}</td>
    </tr>
    <tr>
      <td><strong>Noches:</strong></td>
      <td>{{nights}}</td>
    </tr>
    <tr>
      <td><strong>Huéspedes:</strong></td>
      <td>{{guests}}</td>
    </tr>
    <tr>
      <td><strong>Tipo de pago:</strong></td>
      <td>{{paymentLabel}}</td>
    </tr>
    {{#if discountNote}}
    <tr>
      <td><strong>Descuento:</strong></td>
      <td>{{discountNote}}</td>
    </tr>
    {{/if}}
    <tr>
      <td><strong>Total:</strong></td>
      <td>
        {{#if baseTotal}}
        <span style="text-decoration: line-through; color: #999;">{{baseTotal}}</span><br />
        {{/if}}
        <strong style="font-size: 18px;">{{total}}</strong>
      </td>
    </tr>
  </table>

  <p style="margin-top: 24px;">Gracias por elegir Total Hostel 🏨✨</p>
</div>